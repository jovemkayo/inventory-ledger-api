  "components": {
    "schemas": {
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "unit",
          "minimumStock"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "l",
              "ml"
            ]
          },
          "minimumStock": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "unit",
          "minimumStock",
          "id",
          "stock",
          "createdAt"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "l",
              "ml"
            ]
          },
          "minimumStock": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MovementInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "type",
          "quantity",
          "reason"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4"
          },
          "type": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "Movement": {
        "type": "object",
        "required": [
          "productId",
          "type",
          "quantity",
          "reason",
          "id",
          "createdAt"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4"
          },
          "type": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000,
            "multipleOf": 0.001
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MovementPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
