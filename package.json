{
  "name": "inventory-ledger-api",
  "version": "1.0.0",
  "private": true,
  "description": "Local TypeScript inventory API with atomic stock movements and SQLite history",
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/server.ts",
    "start": "node dist/src/server.js",
    "seed": "node scripts/seed.ts"
  },
  "devDependencies": { "@types/node": "24.10.0", "typescript": "5.8.3" }
}
